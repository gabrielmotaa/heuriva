ENVIRONMENT=local
SECRET_KEY=extra-secret!
DATABASE_URL=postgres://heuriva:heuriva@db:5432/heuriva_dev
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,*
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db
# Feature Flags
# Set to "True" to enable user registration and login
# Set to "False" to disable (shows "Em Breve" instead)
REGISTRATION_ENABLED=True

# LLM Configuration
# Provider: gemini, openai, anthropic (currently only gemini is implemented)
LLM_PROVIDER=gemini

# Gemini API Key - Get one at: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=your-api-key-here

# Gemini Model - Options: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# LLM settings - adjust according to your API plan
LLM_MAX_CALLS_PER_MINUTE=15
LLM_MIN_DELAY_BETWEEN_CALLS=0

# Production settings - copy and rename to .env.prod for production use

# CSRF trusted origins (include scheme). Example: https://heuriva.io
# CSRF_TRUSTED_ORIGINS=https://heuriva.io

# HTTPS / HSTS / Cookies
# Keep these enabled in production
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True


# S3-compatible storage (Cloudflare R2, AWS S3, MinIO, etc.)
# For Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# For AWS S3: https://s3.<REGION>.amazonaws.com (or leave empty for default)
# AWS_STORAGE_BUCKET_NAME=heuriva-media
# AWS_S3_ENDPOINT_URL=https://<YOUR_ACCOUNT_ID>.r2.cloudflarestorage.com
# AWS_S3_ACCESS_KEY_ID=<YOUR_ACCESS_KEY_ID>
# AWS_S3_SECRET_ACCESS_KEY=<YOUR_SECRET_ACCESS_KEY>

# Email (configure your SMTP provider)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-smtp-user
# EMAIL_HOST_PASSWORD=your-smtp-password
# DEFAULT_FROM_EMAIL=noreply@heuriva.com.br
# SERVER_EMAIL=errors@heuriva.com.br
# ADMIN_EMAIL=you@yourdomain.com
