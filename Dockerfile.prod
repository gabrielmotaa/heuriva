################################################################################
# Stage 1: Build Tailwind CSS
################################################################################
FROM node:24-slim AS tailwind-builder

WORKDIR /app

# Copy package files and install dependencies
COPY package.json package-lock.json ./
RUN npm install

# Copy only files needed for Tailwind compilation
COPY heuriva/tailwind ./heuriva/tailwind
COPY heuriva/templates ./heuriva/templates
COPY heuriva/apps ./heuriva/apps

# Build Tailwind CSS (minified for production)
RUN npx @tailwindcss/cli \
    -i ./heuriva/tailwind/input.css \
    -o ./styles.css \
    --minify


################################################################################
# Stage 2: Final production image
################################################################################
FROM ghcr.io/astral-sh/uv:python3.13-trixie-slim

# Install only runtime dependencies (netcat for healthchecks, gettext for translations)
RUN apt-get update && \
    apt-get install -y --no-install-recommends netcat-traditional gettext && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd --system --gid 999 nonroot && \
    useradd --system --gid 999 --uid 999 --create-home nonroot

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Create playwright directory with proper permissions
RUN mkdir -p /ms-playwright && chmod -R 777 /ms-playwright

WORKDIR /app

# Install dependencies
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    uv sync --locked --no-install-project --no-dev

# Copy application code FIRST
COPY --chown=nonroot:nonroot . /app

# THEN overwrite with compiled Tailwind CSS (minified)
COPY --from=tailwind-builder --chown=nonroot:nonroot /app/styles.css /app/heuriva/static/css/styles.css

# Create necessary directories with proper permissions
RUN mkdir -p /app/media /app/staticfiles && \
    chown -R nonroot:nonroot /app/media /app/staticfiles && \
    chmod -R 755 /app/media /app/staticfiles

# Set PATH to use virtual environment
ENV PATH="/app/.venv/bin:$PATH"

# Install project in production mode (no dev dependencies)
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --locked --no-dev

# Install Playwright browsers
RUN playwright install chromium --with-deps && rm -rf /var/lib/apt/lists/*

USER nonroot

EXPOSE 8000

ENTRYPOINT ["./docker-entrypoint.sh"]

CMD ["gunicorn", "heuriva.wsgi:application", \
    "--bind", "0.0.0.0:8000", \
    "--workers", "4", \
    "--threads", "2", \
    "--worker-class", "gthread", \
    "--worker-tmp-dir", "/dev/shm", \
    "--max-requests", "1000", \
    "--max-requests-jitter", "50", \
    "--timeout", "120", \
    "--graceful-timeout", "30", \
    "--keep-alive", "5", \
    "--access-logfile", "-", \
    "--error-logfile", "-", \
    "--log-level", "info", \
    "--capture-output", \
    "--enable-stdio-inheritance"]
